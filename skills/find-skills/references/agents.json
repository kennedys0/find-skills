{
  "note": "Skill folders per agent. `~` is the home directory, `{config}` is $XDG_CONFIG_HOME or ~/.config. An agent counts as installed when any `detect` path exists. Paths follow vercel-labs/skills (src/agents.ts, checked 2026-11-21).",
  "agents": {
    "kiro":        {"name": "Kiro (IDE and CLI)", "project": ".kiro/skills",      "global": "~/.kiro/skills",               "detect": ["~/.kiro"],                         "aliases": ["kiro-cli"]},
