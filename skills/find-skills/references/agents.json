    "grok":        {"name": "Grok Build",         "project": ".grok/skills",      "global": "~/.grok/skills",               "detect": ["~/.grok"]},
    "agents":      {"name": "Generic .agents/skills (shared by Codex, Pi, Cline, Kimi, Warp, Zed)", "project": ".agents/skills", "global": "~/.agents/skills", "detect": [], "aliases": ["universal"]}
  }
}
