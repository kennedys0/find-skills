    "codex":       {"name": "Codex CLI",          "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["~/.codex"]},
    "antigravity": {"name": "Antigravity (IDE and CLI)", "project": ".agents/skills", "global": "~/.gemini/config/skills",  "detect": ["~/.gemini/antigravity", "~/.gemini/antigravity-cli"], "aliases": ["antigravity-cli", "agy"]},
    "gemini":      {"name": "Gemini CLI",         "project": ".agents/skills",    "global": "~/.gemini/skills",             "detect": ["~/.gemini"],                       "aliases": ["gemini-cli"]},
    "opencode":    {"name": "OpenCode",           "project": ".agents/skills",    "global": "{config}/opencode/skills",     "detect": ["{config}/opencode"]},
    "pi":          {"name": "Pi",                 "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["~/.pi/agent"]},
    "cursor":      {"name": "Cursor",             "project": ".agents/skills",    "global": "~/.cursor/skills",             "detect": ["~/.cursor"]},
    "copilot":     {"name": "GitHub Copilot",     "project": ".agents/skills",    "global": "~/.copilot/skills",            "detect": ["~/.copilot"],                      "aliases": ["github-copilot"]},
    "windsurf":    {"name": "Windsurf",           "project": ".windsurf/skills",  "global": "~/.codeium/windsurf/skills",   "detect": ["~/.codeium/windsurf"]},
    "cline":       {"name": "Cline",              "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["~/.cline"]},
    "kimi":        {"name": "Kimi Code CLI",      "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["~/.kimi-code", "~/.kimi"],         "aliases": ["kimi-code-cli"]},
    "amp":         {"name": "Amp",                "project": ".agents/skills",    "global": "{config}/agents/skills",       "detect": ["{config}/amp"]},
    "droid":       {"name": "Factory Droid",      "project": ".agents/skills",    "global": "~/.factory/skills",            "detect": ["~/.factory"]},
    "goose":       {"name": "Goose",              "project": ".goose/skills",     "global": "{config}/goose/skills",        "detect": ["{config}/goose"]},
    "qwen":        {"name": "Qwen Code",          "project": ".qwen/skills",      "global": "~/.qwen/skills",               "detect": ["~/.qwen"],                         "aliases": ["qwen-code"]},
    "qoder":       {"name": "Qoder",              "project": ".qoder/skills",     "global": "~/.qoder/skills",              "detect": ["~/.qoder"]},
    "trae":        {"name": "Trae",               "project": ".trae/skills",      "global": "~/.trae/skills",               "detect": ["~/.trae"]},
    "roo":         {"name": "Roo Code",           "project": ".roo/skills",       "global": "~/.roo/skills",                "detect": ["~/.roo"]},
    "kilo":        {"name": "Kilo Code",          "project": ".agents/skills",    "global": "~/.kilo/skills",               "detect": ["~/.kilo", "~/.kilocode"]},
    "junie":       {"name": "Junie",              "project": ".junie/skills",     "global": "~/.junie/skills",              "detect": ["~/.junie"]},
    "augment":     {"name": "Augment",            "project": ".augment/skills",   "global": "~/.augment/skills",            "detect": ["~/.augment"]},
    "continue":    {"name": "Continue",           "project": ".continue/skills",  "global": "~/.continue/skills",           "detect": ["~/.continue"]},
    "crush":       {"name": "Crush",              "project": ".crush/skills",     "global": "{config}/crush/skills",        "detect": ["{config}/crush"]},
    "openhands":   {"name": "OpenHands",          "project": ".openhands/skills", "global": "~/.openhands/skills",          "detect": ["~/.openhands"]},
    "warp":        {"name": "Warp",               "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["~/.warp"]},
    "zed":         {"name": "Zed",                "project": ".agents/skills",    "global": "~/.agents/skills",             "detect": ["{config}/zed"]},
    "hermes":      {"name": "Hermes Agent",       "project": ".hermes/skills",    "global": "~/.hermes/skills",             "detect": ["~/.hermes"],                       "aliases": ["hermes-agent"]},
